[Unit]
Description=Configure RK3588 CAN0 interface
After=systemd-modules-load.service
Before=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=15
Environment=CAN_INTERFACE=can0
Environment=CAN_BITRATE=500000
Environment=CAN_RESTART_MS=100
ExecStart=/home/cat/rk3588/can0_start.sh --service
ExecStop=/home/cat/rk3588/can0_stop.sh --service

[Install]
WantedBy=multi-user.target
